{%- from '../../_includes/components/Atoms/Button/Button.njk' import Button %}
{%- from '../../_includes/components/Atoms/Paragraph/Paragraph.njk' import Paragraph %}
{%- from '../../_includes/components/Molecules/BasketItem/BasketItem.njk' import BasketItem %}
<div class="cart">
  {{ Button(href = '/cart-checkout', fullWidth = true, Label = 'CHECKOUT', showIconRight = true, IconContentRight = 'Payment', disabled = false) }}
  <div class="cart_price">
    {{ Paragraph( Content = 'Zwischensumme', Size = '-sizeS', Weight = 'medium' ) }}
    {{ Paragraph( Content = '0,00€', Size = '-sizeS', Weight = 'medium' ) }}
  </div>
  <span class="cart_item-count">{{ Paragraph( Content = '(0 Artikel)', Size = '-sizeXS', Weight = 'regular' ) }}</span>
</div>
<div class="cart-empty">
  {# {{ BasketItem ( ProductId = 'genmaicha', ItemImage = { src: '/assets/img/ProductImage4.jpg' }, ShowDivider = false ) }} #}
  {{ Paragraph( Content = 'Dein Warenkorb ist leer', Size = '-sizeL', Weight = 'regular' ) }}
</div>